# ==============================================
# MTK - Environment Variables (Production)
# ==============================================
# Copy this file to .env and update the values
# ==============================================

# ============ PostgreSQL (Keycloak) ============
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=CHANGE_THIS_PASSWORD_IN_PRODUCTION

# ============ Keycloak Settings ============
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_THIS_PASSWORD_IN_PRODUCTION

# Keycloak Command (use 'start' for production, 'start-dev' for development)
KC_COMMAND=start

# Keycloak Hostname (your production domain)
KC_HOSTNAME=yourdomain.com
KC_HOSTNAME_STRICT=true
KC_HOSTNAME_STRICT_HTTPS=true
KC_HTTP_ENABLED=false

# ============ PostgreSQL (MTK Application) ============
MTK_DB_NAME=MTK
MTK_DB_USER=mtkuser
MTK_DB_PASSWORD=CHANGE_THIS_PASSWORD_IN_PRODUCTION

# ============ MTK Application Settings ============
# Note: These are optional - can also be set in Dokploy UI
# ConnectionStrings__Database will override appsettings.json

# Example for production:
# ConnectionStrings__Database=Host=mtk-postgres;Port=5432;Database=MTK;Username=mtkuser;Password=YOUR_PASSWORD;Include Error Detail=false

# Keycloak Integration (update after Keycloak setup)
# Keycloak__AuthClientSecret=YOUR_CLIENT_SECRET_HERE
# Keycloak__AdminClientSecret=YOUR_ADMIN_CLIENT_SECRET_HERE
